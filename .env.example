# ─── Database ────────────────────────────────────────────────────────────────
# Local development: `docker compose up -d` starts Postgres with these creds.
DATABASE_URI=

# Production (Neon): use the POOLED connection string — the host contains
# "-pooler". The direct one runs out of connections on serverless.
# DATABASE_URI=postgresql://USER:PASS@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#
# TLS is turned on automatically for any non-local host, so ?sslmode=require is
# belt and braces. Only set this if the provider's certificate cannot be
# verified (you'd see "self signed certificate in certificate chain"):
# DATABASE_SSL_NO_VERIFY=true

# ─── Payload ─────────────────────────────────────────────────────────────────
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=
# ─── Media storage (Supabase S3) — optional ──────────────────────────────────
# With both credentials unset, uploads are written to public/media on the local
# disk. With either credential set, S3_BUCKET and S3_ENDPOINT are required too —
# a half-configured bucket fails at boot rather than quietly falling back to the
# disk.
# The public URL of an upload is derived from S3_ENDPOINT, so the project ref is
# written once, here, and cannot drift from the bucket the files went to.
S3_BUCKET=
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-south-1

# ─── Image generation (Gemini) — optional ────────────────────────────────────
# Powers the editor's "Generate images" button, which turns a writer's
# [Feature image — Alt text: "..." Photo direction: ...] tag into a real image.
# Both vars are required together: with either unset the route returns 503 and
# names the missing one, and nothing else in the app is affected.
GEMINI_API_KEY=
#
# The image model, with no default in code — change it here and nowhere else
# when Google ships a newer one. It must be an *image* model; a text model id
# here is rejected by the API, not silently ignored. Current options, best
# first:
#   gemini-3-pro-image        Nano Banana Pro   — best quality, slowest
#   gemini-3.1-flash-image    Nano Banana 2     — the sensible default
#   gemini-3.1-flash-lite-image                 — fastest, cheapest
#   gemini-2.5-flash-image    Nano Banana       — legacy
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ─── Multi-site publishing ───────────────────────────────────────────────────
# One block per website. src/config/sites.ts says what each website *is* (its
# name, the path it serves blogs from); these vars say where to deploy to, so
# the same build can point at a fork locally and the real repo in production.
# Which block is used is decided by the website picked in the sidebar.
#
# There are no code fallbacks: if a var below is unset, publishing to that
# website fails with a message naming the var, and the post still saves. That
# is deliberate — a default owner/repo would ship a finished article into the
# wrong repository.
#
# Each token is a GitHub fine-grained personal access token scoped to that one
# repository, with "Contents: read and write" (GitHub adds read-only Metadata
# itself). No Actions permission: dispatching is a Contents-write operation.
#
# Note there is no *_GITHUB_BRANCH and no *_GITHUB_EVENT_TYPE.
# repository_dispatch only runs the workflow on the repo's default branch and
# the workflow commits back to that same branch, so a branch here would do
# nothing. The event type is the same 'publish-blog' contract in every
# receiving workflow, so it lives in src/config/sites.ts as one constant.

# The repo is written the way GitHub writes it, `owner/repo` — both halves in
# one var, because they identify one thing and must not drift apart. Point a
# site at a fork by editing this one line.

# OVO Painting
OVO_GITHUB_REPO=
OVO_GITHUB_TOKEN=
OVO_SITE_BASE_URL=

# Durahome Painting. Its repo's default branch is `design-updates`, so that is
# where publish-blog.yml has to live and what Vercel has to build.
DURAHOME_GITHUB_REPO=
DURAHOME_GITHUB_TOKEN=
DURAHOME_SITE_BASE_URL=

# Ranger Painting
RANGER_GITHUB_REPO=
RANGER_GITHUB_TOKEN=
RANGER_SITE_BASE_URL=

# ─── Scheduled publishing (Upstash QStash) ───────────────────────────────────
# All three come from https://console.upstash.com/qstash -> "Request Builder" /
# the env panel on that page. Copy them verbatim.
#
# Used to queue and cancel scheduled publishes.
QSTASH_TOKEN=
# The base URL shown next to the token in the console. Optional — the SDK
# defaults to the EU endpoint (https://qstash.upstash.io) — but set it to
# whatever the console shows so the region is never in doubt.
QSTASH_URL=
# Used to verify that a callback really came from QStash. Both are required;
# the "next" key exists so Upstash can rotate keys without downtime.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Where QStash should call back. Defaults to NEXT_PUBLIC_SERVER_URL, which is
# right in production.
# QSTASH_CALLBACK_URL=https://your-tunnel.trycloudflare.com

# Local development: runs QStash's own dev server, so none of the keys above are
# needed and localhost callbacks work. Never set this in production.
# QSTASH_DEV=true
