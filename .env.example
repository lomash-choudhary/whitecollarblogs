# ─── Database ────────────────────────────────────────────────────────────────
# Local development: `docker compose up -d` starts Postgres with these creds.
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/payload

# Production (Neon): use the POOLED connection string — the host contains
# "-pooler". The direct one runs out of connections on serverless.
# DATABASE_URI=postgresql://USER:PASS@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#
# TLS is turned on automatically for any non-local host, so ?sslmode=require is
# belt and braces. Only set this if the provider's certificate cannot be
# verified (you'd see "self signed certificate in certificate chain"):
# DATABASE_SSL_NO_VERIFY=true

# ─── Payload ─────────────────────────────────────────────────────────────────
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Media storage (Supabase S3) — optional ──────────────────────────────────
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-south-1
S3_PROJECT_REF=

# ─── Multi-site publishing: OVO Painting ─────────────────────────────────────
# REQUIRED to publish blogs to the OVO Painting website.
# A GitHub fine-grained personal access token scoped to the ovopainting repo
# with the "Contents: read and write" permission.
OVO_GITHUB_TOKEN=

# Optional — only set these if the repo moves or you publish to another branch.
OVO_GITHUB_OWNER=nshekhawat153-star
OVO_GITHUB_REPO=ovopainting
OVO_GITHUB_BRANCH=main
OVO_GITHUB_EVENT_TYPE=publish-blog
OVO_SITE_BASE_URL=https://www.ovopainting.com

# Testing only — point dispatches at a local stub instead of GitHub.
# GITHUB_API_BASE_URL=http://127.0.0.1:8899

# ─── Admin account recovery ──────────────────────────────────────────────────
# /api/reset-password creates or resets the admin login. It works freely in
# development. In production it is OFF unless you set all three of these, and
# the request must pass ?token=<ADMIN_RESET_TOKEN>.
# Leave them unset in production to keep the route disabled.
# ADMIN_RESET_TOKEN=
# ADMIN_RESET_EMAIL=
# ADMIN_RESET_PASSWORD=
