# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temp tool directories
.playwright-mcp/


# local sqlite leftover (the app runs on Postgres)
payload.db

# agents skills
.agents
skills-lock.json

# Agent guidance and working notes — local only, never part of the repo.
# A leading "./" never matches in .gitignore; anchor with a leading "/" instead.
/AGENTS.md
/CLAUDE.md
/memory.md
/MULTISITE_PUBLISHING.md
/PUSH_CHECKLIST.md

# Markdown conformance fixture — a local test input, not shipped content
/test.md
